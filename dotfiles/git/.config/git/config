[alias]
	co = checkout
	fa = fetch --all --prune
	r = !fish -c 'set base (git rev-parse --abbrev-ref HEAD | string match -r \"^(?:saas-\\d+\\.\\d+|\\d+\\.\\d+|master)\") && echo rebase origin/$base && git rebase --autostash origin/$base'
	br = branch -vv
	p = push --set-upstream
	pf = push --set-upstream --force-with-lease
	enforce = push --force-with-lease
	fuck = reset --hard HEAD
	superfuck = reset --hard @{u}
	wip = !fish -c 'git commit -am \"[WIP] \"(curl -s https://whatthecommit.com/index.txt) | sed \"s/.*/\\\"&\\\"/\"'
	cp = cherry-pick
    undo = reset HEAD^

[core]
	excludesfile = ~/.config/git/gitglobalignore
	editor = nvim
	pager = delta

[fetch]
    prune = true

[pull]
    rebase = true

[status]
	showuntrackedfiles = all

[push]
	autoSetupRemote = true
	default = current

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
	plus-style = syntax "#394545"
	plus-emph-style = syntax "#4d6356"
	minus-style = syntax "#493446"
	minus-emph-style = syntax "#694459"
	line-numbers-plus-style = "#a6e3a1"
	line-numbers-minus-style = "#f38ba8"
	line-numbers-zero-style = "#585b70"
	file-style = bold "#89b4fa"
	file-decoration-style = "#89b4fa" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#585b70" box
