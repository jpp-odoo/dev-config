#!/bin/bash
# Bubblewrap-sandboxed Claude Code. Sits ahead of ~/.local/bin on PATH so
# every launcher of a bare `claude` (fish, bash, Omarchy's agent picker/
# keybindings, which exec it directly with no shell involved) gets the same
# sandbox. Canonical copy of the logic that used to live only in the fish
# function ~/.config/fish/functions/claude.fish.

if test "$(id -u)" -eq 0; then
    echo "Do not run this as root" >&2
    exit 1
fi

claude_bin="$HOME/.local/bin/claude"
if [ ! -x "$claude_bin" ]; then
    echo "Claude Code not found at $claude_bin" >&2
    exit 1
fi

# Sessions started unsandboxed by claudio come back unsandboxed on resume
# (herdr restores every claude as `claude --resume <id>`). The list lives
# outside the sandbox, so a sandboxed claude can't add itself to it.
for ((i = 1; i < $#; i++)); do
    if [ "${!i}" = "--resume" ] || [ "${!i}" = "-r" ]; then
        j=$((i + 1))
        if grep -qxF -- "${!j}" "$HOME/.local/state/claudio/sessions" 2>/dev/null; then
            exec fish -c 'claudio $argv' -- "$@"
        fi
    fi
done

claude_dirs=("$HOME/.cache/claude" "$HOME/.cache/claude-cli-nodejs" "$HOME/.claude" "$HOME/.local/state/claude")
for d in "${claude_dirs[@]}"; do
    mkdir -p "$d"
done
claude_files=("$HOME/.claude.json")
for f in "${claude_files[@]}"; do
    [ -e "$f" ] || touch "$f"
done

allow_dirs=("$HOME/src")
claude_args=()
i=1
while [ "$i" -le "$#" ]; do
    arg="${!i}"
    if [ "$arg" = "--add-dir" ]; then
        i=$((i + 1))
        allow_dirs+=("$(realpath "${!i}")")
    else
        claude_args+=("$arg")
    fi
    i=$((i + 1))
done

# Start in the current directory when it is mounted, else in the first allowed dir
chdir="${allow_dirs[0]}"
for d in "${allow_dirs[@]}"; do
    case "$PWD/" in "$d"/*) chdir="$PWD" ;; esac
done

bwrap_args=(
    --bind "$HOME/.local/bin/claude" "$HOME/.local/bin/claude"
    --bind "$HOME/.local/share/claude" "$HOME/.local/share/claude"
    --ro-bind /run/systemd/resolve /run/systemd/resolve
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind /etc/ssl /etc/ssl
    --symlink ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
    --ro-bind /usr /usr
    --symlink usr/bin /bin --symlink usr/sbin /sbin
    --symlink usr/lib /lib --symlink usr/lib64 /lib64
    --ro-bind /etc/passwd /etc/passwd
    --bind /var/run/docker.sock /var/run/docker.sock
    --dev /dev --proc /proc --tmpfs /tmp
    --chdir "$chdir"
    --unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup
    --die-with-parent --hostname claude-sandbox --unsetenv CLAUDIO
)
# --new-session only guards against TIOCSTI terminal injection, but it moves
# claude out of the terminal's foreground group, so herdr can't see it. Skip it
# when the kernel already blocks TIOCSTI (the default since Linux 6.2).
[ "$(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null)" = 0 ] || bwrap_args+=(--new-session)

for d in "${claude_dirs[@]}" "${claude_files[@]}"; do
    bwrap_args+=(--bind "$d" "$d")
done
# herdr's socket, so the herdr hooks can report this claude to the agent list.
# Trade-off: it also lets the sandbox drive herdr, i.e. type into unsandboxed panes.
[ -S "${HERDR_SOCKET_PATH:-}" ] && bwrap_args+=(--bind "$HERDR_SOCKET_PATH" "$HERDR_SOCKET_PATH")
for d in "${allow_dirs[@]}"; do
    bwrap_args+=(--bind "$d" "$d")
    claude_args+=(--add-dir "$d")
done

forbidden=("$HOME/.ssh" "$HOME/.gnupg" "$HOME/.config/gh" \
    "$HOME/.config/1Password" "$HOME/.config/Bitwarden" "$HOME/.mozilla" \
    "$HOME/.docker" "$HOME/.aws")
for d in "${forbidden[@]}"; do
    if bwrap "${bwrap_args[@]}" -- test -e "$d" 2>/dev/null; then
        echo "FAIL: $d is reachable inside the sandbox, aborting" >&2
        exit 1
    fi
done

exec bwrap "${bwrap_args[@]}" -- "$claude_bin" "${claude_args[@]}"
