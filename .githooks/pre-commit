#!/bin/sh
# Public repo: refuse any commit that would expose secrets or private files.
# Enabled per clone with: git config core.hooksPath .githooks

bad=$(git diff --cached --name-only --diff-filter=ACMR |
    grep -E '(^|/)(\.credentials\.json|history\.jsonl|id_[a-z0-9]+|[^/]*\.(pem|key)|\.env(\.[^/]*)?|settings\.local\.json|known_hosts)$')
if [ -n "$bad" ]; then
    printf 'pre-commit: private files staged, commit refused:\n%s\n' "$bad" >&2
    exit 1
fi

if ! command -v gitleaks >/dev/null; then
    echo "pre-commit: gitleaks is missing (sudo pacman -S gitleaks), commit refused" >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
